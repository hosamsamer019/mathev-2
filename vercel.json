{
  "name": "mathev-2",
  "version": 2,
  "buildCommand": "cd apps/frontend && npm install && npm run build",
  "outputDirectory": "apps/frontend/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/auth/:match*", "destination": "https://api.alsaden.com/api/auth/:match*" },
    { "source": "/api/users/:match*", "destination": "https://api.alsaden.com/api/users/:match*" },
    { "source": "/api/ai/:match*", "destination": "https://api.alsaden.com/api/ai/:match*" },
    { "source": "/api/courses/:match*", "destination": "https://api.alsaden.com/api/courses/:match*" },
    { "source": "/api/homework/:match*", "destination": "https://api.alsaden.com/api/homework/:match*" },
    { "source": "/api/exams/:match*", "destination": "https://api.alsaden.com/api/exams/:match*" },
    { "source": "/api/questions/:match*", "destination": "https://api.alsaden.com/api/questions/:match*" },
    { "source": "/api/upload/:match*", "destination": "https://api.alsaden.com/api/upload/:match*" },
    { "source": "/api/payments/:match*", "destination": "https://api.alsaden.com/api/payments/:match*" },
    { "source": "/api/analytics/:match*", "destination": "https://api.alsaden.com/api/analytics/:match*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
