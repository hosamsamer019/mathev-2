generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String              @id @default(uuid())
  email          String              @unique
  password       String
  name           String
  createdAt      DateTime            @default(now())
  centerGroupId  String?
  parentId       String?
  updatedAt      DateTime            @updatedAt
  role           Role
  academicLevel  AcademicLevel?
  country        CountryCode?
  educationLevel EducationLevel?
  gradeLevel     GradeLevel?
  language       String              @default("ar")
  phone          String?
  isGuest        Boolean             @default(false)
  attendances    Attendance[]
  chatSessions   ChatSession[]
  taughtCourses  Course[]            @relation("TeacherCourses")
  enrollments    CourseEnrollment[]
  examAttempts   ExamAttempt[]
  notifications  Notification[]
  payments       Payment[]
  questionBank   QuestionBank[]
  mathSolutions  SavedMathSolution[]
  submissions    Submission[]
  centerGroup    CenterGroup?        @relation(fields: [centerGroupId], references: [id])
  parent         User?               @relation("ParentChildren", fields: [parentId], references: [id])
  children       User[]              @relation("ParentChildren")
  sessions       UserSession[]
  videoProgress  VideoProgress[]
  videoUploads   VideoUpload[]

  // Unified Assessments
  teacherAssessments Assessment[]        @relation("TeacherAssessments")
  assessmentAttempts AssessmentAttempt[]
}

model CenterGroup {
  id        String   @id @default(uuid())
  name      String
  schedule  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  students  User[]
}

model Course {
  id             String             @id @default(uuid())
  title          String
  description    String?
  createdAt      DateTime           @default(now())
  teacherId      String
  updatedAt      DateTime           @updatedAt
  category       String?
  price          Float              @default(0)
  status         String             @default("PUBLISHED")
  academicLevel  AcademicLevel?
  country        CountryCode?
  educationLevel EducationLevel?
  gradeLevel     GradeLevel?
  teacher        User               @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments    CourseEnrollment[]
  exams          Exam[]
  homeworks      Homework[]
  lessons        Lesson[]

  assessments Assessment[]

  @@index([teacherId])
}

model CourseEnrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model Lesson {
  id          String          @id @default(uuid())
  title       String
  videoUrl    String?
  createdAt   DateTime        @default(now())
  publishedAt DateTime?
  courseId    String
  updatedAt   DateTime        @updatedAt
  pdfUrl      String?
  Homework    Homework[]
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes     LessonQuiz[]
  progress    VideoProgress[]

  assessments Assessment[]

  @@index([courseId])
}

model Exam {
  id             String        @id @default(uuid())
  title          String
  courseId       String
  duration       Int           @default(60)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  questions      Json?
  requiresCamera Boolean       @default(false)
  endTime        DateTime?
  passingScore   Float         @default(50)
  randomization  Boolean       @default(false)
  startTime      DateTime?
  instantGrading Boolean       @default(true)
  showResult     Boolean       @default(true)
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts       ExamAttempt[]
}

model ExamAttempt {
  id            String          @id @default(uuid())
  examId        String
  score         Float
  createdAt     DateTime        @default(now())
  studentId     String
  answers       Json?
  exam          Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ExamViolation ExamViolation[]

  @@index([studentId])
  @@index([examId])
}

model Homework {
  id          String       @id @default(uuid())
  title       String
  courseId    String
  deadline    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  questions   Json?
  lessonId    String?
  closeAt     DateTime?
  duration    Int?
  openAt      DateTime?
  type        String       @default("NORMAL")
  videoId     String?
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id         String   @id @default(uuid())
  studentId  String
  homeworkId String
  grade      Float?
  url        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  answers    Json?
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([homeworkId])
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  amount          Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  date            DateTime      @default(now())
  courseId        String?
  currency        String        @default("EGP")
  metadata        Json?
  provider        String?
  providerOrderId String?
  status          PaymentStatus @default(PENDING)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerOrderId])
  @@index([createdAt])
}

model VideoProgress {
  id              String   @id @default(uuid())
  studentId       String
  lessonId        String
  watched         Boolean  @default(false)
  progress        Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastTimestamp   Float    @default(0)
  answeredQuizzes Json?

  status               String    @default("NOT_STARTED")
  firstOpenedAt        DateTime?
  firstActivityAt      DateTime?
  lastActivityAt       DateTime?
  lastProgressUpdateAt DateTime?
  totalWatchTimeSec    Int       @default(0)
  watchSessionsCount   Int       @default(0)
  completedAt          DateTime?
  completionSource     String    @default("NONE")

  currentRiskLevel String    @default("NONE")
  currentRiskCode  String?
  riskDetectedAt   DateTime?

  lesson      Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  riskHistory StudentRiskHistory[]

  @@unique([studentId, lessonId])
}

model Assessment {
  id          String         @id @default(uuid())
  title       String
  description String?
  type        AssessmentType // ASSIGNMENT, QUIZ, EXAM
  courseId    String
  lessonId    String?
  teacherId   String

  openAt          DateTime?
  closeAt         DateTime?
  durationMinutes Int?

  status      String @default("PUBLISHED")
  totalPoints Float  @default(100)

  questions Json?

  passingScore   Float?
  showResult     Boolean @default(true)
  randomization  Boolean @default(false)
  requiresCamera Boolean @default(false)

  allowExternalStudents Boolean @default(false)
  examAccessCode        String? @unique
  allowedIps            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course           Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson           Lesson?               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacher          User                  @relation("TeacherAssessments", fields: [teacherId], references: [id])
  attempts         AssessmentAttempt[]
  externalAttempts ExternalExamAttempt[]
}

model ExternalExamAttempt {
  id              String        @id @default(uuid())
  assessmentId    String
  studentName     String
  phone           String?
  accessSessionId String?       @unique
  ipAddress       String?
  userAgent       String?
  answers         Json?
  score           Float?
  percentage      Float?
  status          AttemptStatus @default(STARTED)
  startedAt       DateTime      @default(now())
  submittedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  violationCount     Int       @default(0)
  cheatingDetected   Boolean   @default(false)
  cheatingReason     String?
  cheatingDetectedAt DateTime?
  violations         Json?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([studentName])
  @@index([status])
  @@index([createdAt])
}

model AssessmentAttempt {
  id           String @id @default(uuid())
  assessmentId String
  studentId    String

  status AttemptStatus

  startedAt   DateTime  @default(now())
  expiresAt   DateTime?
  submittedAt DateTime?

  score       Float?
  totalPoints Float?
  percentage  Float?

  answers Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  violationCount     Int       @default(0)
  cheatingDetected   Boolean   @default(false)
  cheatingReason     String?
  cheatingDetectedAt DateTime?
  violations         Json?
  ipAddress          String?
  userAgent          String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assessmentId])
  @@index([assessmentId])
}

model StudentRiskHistory {
  id             String    @id @default(uuid())
  studentId      String
  lessonId       String
  riskLevel      String
  riskCode       String
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionCode String?

  videoProgress VideoProgress @relation(fields: [studentId, lessonId], references: [studentId, lessonId], onDelete: Cascade)
}

model LessonQuiz {
  id            String   @id @default(uuid())
  lessonId      String
  timestampSec  Float
  question      String
  options       String[]
  correctAnswer String
  createdAt     DateTime @default(now())
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      String
  content   String
  tokens    Int?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuestionBank {
  id                  String          @id @default(uuid())
  text                String
  type                String          @default("MCQ")
  options             Json
  correctAnswer       Int?
  explanation         String?
  tag                 String?
  subject             String?
  topic               String?
  difficulty          String?
  academicLevel       AcademicLevel?
  country             CountryCode?
  educationLevel      EducationLevel?
  gradeLevel          GradeLevel?
  mathExpression      String?
  diagram             Json?
  solutionSteps       Json?
  given               Json?
  required            String?
  generationLogic     Json? // { questionDesign, mathematicalMethod, difficultyReason, learningObjective }
  solutionExplanation String? // Concise pedagogical solution narrative
  validationStatus    String? // STRUCTURALLY_VALID | MATHEMATICALLY_VERIFIED | NEEDS_REVIEW | INVALID
  source              String          @default("MANUAL")
  creatorId           String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  creator             User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model SavedMathSolution {
  id        String   @id @default(uuid())
  studentId String
  problem   String
  solution  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model VideoUpload {
  id           String       @id @default(uuid())
  userId       String
  filename     String
  storagePath  String
  status       UploadStatus @default(PENDING)
  fileSize     BigInt?
  mimeType     String?
  errorMessage String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  deviceName       String?
  ipAddress        String?
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  lastActiveAt     DateTime  @default(now())
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DailyPlatformStats {
  id             String   @id @default(uuid())
  date           DateTime @unique
  usersCount     Int      @default(0)
  activeUsers    Int      @default(0)
  videosWatched  Int      @default(0)
  examsCompleted Int      @default(0)
  revenue        Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
}

model ExamViolation {
  id          String      @id
  attemptId   String
  type        String
  timestamp   DateTime    @default(now())
  ExamAttempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

enum Role {
  ADMIN
  TEACHER
  ONLINE_STUDENT
  CENTER_STUDENT
  PARENT
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOAD_COMPLETED
  PROCESSING
  TRANSCODING
  COMPLETED
  FAILED
}

enum AcademicLevel {
  PREP_1
  PREP_2
  PREP_3
  SEC_1
  SEC_2
  SEC_3
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum CountryCode {
  EG
}

enum EducationLevel {
  PRIMARY
  PREPARATORY
  SECONDARY
  UNIVERSITY
  OTHER
}

enum GradeLevel {
  PRIMARY_1
  PRIMARY_2
  PRIMARY_3
  PRIMARY_4
  PRIMARY_5
  PRIMARY_6
  PREPARATORY_1
  PREPARATORY_2
  PREPARATORY_3
  SECONDARY_1
  SECONDARY_2
  SECONDARY_3
  OTHER
}

enum AssessmentType {
  ASSIGNMENT
  QUIZ
  EXAM
}

enum AttemptStatus {
  STARTED
  IN_PROGRESS
  SUBMITTED
  TIME_EXPIRED
  GRADED
  CHEATING
}
