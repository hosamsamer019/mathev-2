generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  ONLINE_STUDENT
  CENTER_STUDENT
  PARENT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Parent-Student Link
  parentId String?
  parent   User?   @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children User[]  @relation("ParentChildren")

  // Center Group (Only for CENTER_STUDENT)
  centerGroupId String?
  centerGroup   CenterGroup? @relation(fields: [centerGroupId], references: [id], onDelete: SetNull)

  // Teacher relationships
  taughtCourses Course[] @relation("TeacherCourses")

  // Student relationships
  enrollments   CourseEnrollment[]
  submissions   Submission[]
  examAttempts  ExamAttempt[]
  attendances   Attendance[]
  payments      Payment[]
  videoProgress VideoProgress[]
  chatSessions  ChatSession[]
  notifications Notification[]
  questions     Question[]
  mathSolutions SavedMathSolution[]
}

model CenterGroup {
  id        String   @id @default(uuid())
  name      String
  schedule  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students User[]
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User               @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  enrollments CourseEnrollment[]
  exams       Exam[]
  homeworks   Homework[]
}

model CourseEnrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Lesson {
  id        String   @id @default(uuid())
  title     String
  videoUrl  String?
  pdfUrl    String?
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress VideoProgress[]
  quizzes  LessonQuiz[]
}

model Exam {
  id        String   @id @default(uuid())
  title     String
  duration  Int      @default(60)
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts ExamAttempt[]
  questions Json?
  requiresCamera Boolean @default(false)
}

model ExamAttempt {
  id        String   @id @default(uuid())
  studentId String
  examId    String
  score     Float
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam    Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers Json?
}

model Homework {
  id        String   @id @default(uuid())
  title     String
  deadline  DateTime?
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]
  questions   Json?
}

model Submission {
  id         String   @id @default(uuid())
  studentId  String
  homeworkId String
  grade      Float?
  url        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  answers  Json?
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  date      DateTime
  status    String   // e.g., PRESENT, ABSENT
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  date      DateTime @default(now())
  status    String   // e.g., COMPLETED, PENDING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VideoProgress {
  id        String   @id @default(uuid())
  studentId String
  lessonId  String
  watched   Boolean  @default(false)
  progress  Float    @default(0) // Percentage watched (0 to 100)
  lastTimestamp Float @default(0) // Track exact second watched
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model LessonQuiz {
  id            String   @id @default(uuid())
  lessonId      String
  timestampSec  Float    // When the quiz should pop up
  question      String
  options       String[] // JSON string or array
  correctAnswer String
  createdAt     DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

model ChatMessage {
  id         String   @id @default(uuid())
  sessionId  String
  role       String   // e.g., 'user' or 'assistant'
  content    String
  tokens     Int?
  createdAt  DateTime @default(now())

  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // 'success' | 'warning' | 'info' | 'course'
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Question {
  id            String   @id @default(uuid())
  teacherId     String
  text          String
  type          String   @default("MCQ")
  options       Json
  correctAnswer Int
  tag           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher       User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model SavedMathSolution {
  id        String   @id @default(uuid())
  studentId String
  problem   String
  solution  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
